# ==============================================================================
# Environment Configuration Template - Roswell Cruz Portfolio
# Copy this file to .env and configure your secrets locally
# ==============================================================================

PORT=5000
CLIENT_URL=http://localhost:5173

# PostgreSQL connection URL (e.g. Neon, Supabase, Render, local)
DATABASE_URL=postgresql://username:password@hostname:5432/databasename?sslmode=require

# Brevo Email API (HTTPS REST - port 443)
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_SENDER=roswellcruz.dev@gmail.com
NOTIFY_TO=roswellcruz.dev@gmail.com
